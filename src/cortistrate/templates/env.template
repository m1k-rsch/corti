# =====================================================
# Cortistrate — md-first Memory Extraction Framework
# Configuration Template
# =====================================================
#
# Setup:
#   1. cp env.template .env
#   2. Edit .env with your values
#   3. .env is gitignored (never commit)
#
# Override priority (low → high):
#   src/cortistrate/config/default.toml         (shipped baseline)
#     ↓
#   <root>/cortistrate.toml                     (user config; optional; root resolved
#                                           by CORTISTRATE_ROOT env > ~/.cortistrate)
#     ↓
#   CORTISTRATE_<SECTION>__<KEY> process envs   (this file sources these)
#     ↓
#   programmatic init args / CLI flags
# =====================================================


# ─── LLM (OpenAI-protocol compatible) ────────────────
# Any OpenAI-API-compatible endpoint plugs in via base_url. Defaults
# below target OpenRouter (one key, broad model catalogue); switch to
# OpenAI, vLLM, Ollama (OpenAI bridge), or any other compatible endpoint
# by changing model + base_url + api_key.

CORTISTRATE_LLM__MODEL=openai/gpt-4.1-mini
CORTISTRATE_LLM__API_KEY=
CORTISTRATE_LLM__BASE_URL=https://openrouter.ai/api/v1


# ─── Multimodal LLM (independent from [llm]; vision/audio capable) ────
# Separate model for parsing multimodal content items (image / pdf /
# audio / ...); must support OpenAI image_url parts. Defaults target
# Gemini via OpenRouter so the same key covers chat + multimodal.

CORTISTRATE_MULTIMODAL__MODEL=google/gemini-3-flash-preview
CORTISTRATE_MULTIMODAL__API_KEY=
CORTISTRATE_MULTIMODAL__BASE_URL=https://openrouter.ai/api/v1
# Concurrency cap for parallel multimodal calls (default 4):
# CORTISTRATE_MULTIMODAL__MAX_CONCURRENCY=4
#
# file:// content-item support (read locally by Cortistrate, not everalgo).
# Size cap per file:// asset (bytes; default 50 MiB):
# CORTISTRATE_MULTIMODAL__FILE_URI_MAX_BYTES=52428800
# Allowlisted base dirs for file:// uris (JSON list). Empty/unset = allow any
# readable file (permissive default); set to confine reads when the API is
# exposed beyond loopback:
# CORTISTRATE_MULTIMODAL__FILE_URI_ALLOW_DIRS=["/srv/uploads"]


# ─── Embedding (OpenAI-protocol /embeddings) ─────────
# Any OpenAI-compatible embedding endpoint plugs in via base_url.
# model / api_key / base_url have no shipped default — set them here
# or in <root>/cortistrate.toml before the embedding capability is used.

CORTISTRATE_EMBEDDING__MODEL=Qwen/Qwen3-Embedding-4B
CORTISTRATE_EMBEDDING__API_KEY=
CORTISTRATE_EMBEDDING__BASE_URL=https://api.deepinfra.com/v1/openai
# Runtime knobs — uncomment to override defaults (30s / 3 / 10 / 5):
# CORTISTRATE_EMBEDDING__TIMEOUT_SECONDS=30
# CORTISTRATE_EMBEDDING__MAX_RETRIES=3
# CORTISTRATE_EMBEDDING__BATCH_SIZE=10
# CORTISTRATE_EMBEDDING__MAX_CONCURRENT=5


# ─── Rerank (OpenAI-protocol /rerank) ────────────────
# base_url should point at the rerank endpoint (e.g. .../v1/rerank).

CORTISTRATE_RERANK__MODEL=Qwen/Qwen3-Reranker-4B
CORTISTRATE_RERANK__API_KEY=
CORTISTRATE_RERANK__BASE_URL=https://api.deepinfra.com/v1/inference
# Runtime knobs — uncomment to override defaults (30s / 3 / 10 / 5):
# CORTISTRATE_RERANK__TIMEOUT_SECONDS=30
# CORTISTRATE_RERANK__MAX_RETRIES=3
# CORTISTRATE_RERANK__BATCH_SIZE=10
# CORTISTRATE_RERANK__MAX_CONCURRENT=5


# ─── Storage paths ───────────────────────────────────
# memory-root holds md files + .index/ (Postgres) + .system.db (SQLite) + ...
# Override the default (~/.cortistrate) with CORTISTRATE_ROOT; also controls which
# cortistrate.toml is loaded.  See config/default.toml for all other tunables.

# CORTISTRATE_ROOT=~/.cortistrate


# ─── HTTP API ────────────────────────────────────────
# Bind for ``cortistrate server start``. Default ``127.0.0.1`` keeps the
# server on loopback only; Cortistrate ships no built-in authentication (see
# SECURITY.md). Set HOST=0.0.0.0 only after you have your own gateway /
# auth layer in front — the CLI logs a warning if you bind to 0.0.0.0.

# CORTISTRATE_API__HOST=127.0.0.1
# CORTISTRATE_API__PORT=8000


# ─── Observability ───────────────────────────────────

CORTISTRATE_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
CORTISTRATE_LOG_FORMAT=json                # json | text
# CORTISTRATE_OTEL_ENDPOINT=http://localhost:4317  # OTel exporter (optional)


# ─── Runtime ─────────────────────────────────────────

# TZ used by component.utils.datetime when input has no timezone
TZ=UTC
